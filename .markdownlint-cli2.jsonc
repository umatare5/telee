{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD003": { "style": "atx" },
    "MD004": { "style": "dash" },
    "MD013": false,
    "MD024": { "siblings_only": true },
    "MD028": false,
    "MD029": { "style": "ordered" },
    "MD046": { "style": "fenced" },
    "MD048": { "style": "backtick" },
    "MD050": { "style": "asterisk" },
    "MD054": { "url_inline": false },
    "MD055": { "style": "leading_and_trailing" },
    "MD060": { "style": "aligned", "aligned_delimiter": true }
  },
  "overrides": [
    {
      "filter": ["AGENTS.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Repository Instructions",
            "## Tech Stack", "*",
            "## Repository Structure", "*",
            "## Setup and Commands", "*",
            "## Code Style", "*",
            "## Testing", "*",
            "## Commits and PRs", "*",
            "## Domain Knowledge", "*"
          ]
        }
      }
    },
    {
      "filter": ["CHANGELOG.md"],
      "combine": "merge",
      "config": {
        // Release headings accrue, this file opens with `## [Unreleased]` and each
        // release groups its entries under `### Added`, `### Changed` and the rest,
        // so only the title is pinned
        "MD043": {
          "match_case": true,
          "headings": [
            "# Changelog",
            "*"
          ]
        }
      }
    },
    {
      "filter": ["CONTRIBUTING.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Contributing",
            "## Commands", "*",
            "## Build", "*",
            "## Release", "*",
            "## Sample identities", "*",
            "## Pull requests"
          ]
        }
      }
    },
    {
      "filter": ["README.md"],
      "combine": "merge",
      "config": {
        // The logo, badges and title block are HTML and the heading they carry is an
        // <h1>; `details`, `summary` and `u` are the collapsed examples under Usage
        "MD033": {
          "allowed_elements": [
            "a", "br", "details", "div", "h1",
            "img", "p", "picture", "source", "summary", "u"
          ]
        },
        "MD041": { "allow_preamble": true },
        "MD043": {
          "match_case": true,
          "headings": [
            "## Overview", "*",
            "## Supported Environment", "*",
            "## Quick Start", "*",
            "## Syntax", "*",
            "## Usage", "*",
            "## Exec Platform", "*",
            "## Configuration", "*",
            "## Troubleshooting", "*",
            "## Contributing", "*",
            "## License"
          ]
        }
      }
    },
    {
      // The policy sections the OSS corpus settles on, pinned exactly: this file states
      // what is reported and how, and never how to operate the CLI. Hardening guidance
      // belongs to docs/configuration.md and docs/troubleshooting.md.
      "filter": ["SECURITY.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Security Policy",
            "## Supported Versions",
            "## Reporting a Vulnerability",
            "## What to Include",
            "## Scope"
          ]
        }
      }
    },
    {
      // An index, then the contracts no single page owns. A section beyond those
      // two would be a fact the page it points at already carries.
      "filter": ["docs/README.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": ["# Documentation", "## Technical Information", "*"]
        }
      }
    },
    {
      "filter": ["docs/configuration.md"],
      "combine": "merge",
      "config": {
        "MD043": {
          "match_case": true,
          "headings": [
            "# Configuration",
            "## Flags", "*",
            "## Environment Variables", "*",
            "## Precedence", "*",
            "## Hardening"
          ]
        }
      }
    },
    {
      // The sole owner of every reading taken against a device. The subject sections
      // are closed; only Reports grows, one heading per measured case.
      "filter": ["docs/measurements.md"],
      "combine": "merge",
      "config": {
        "MD033": { "allowed_elements": ["details", "p", "summary", "u"] },
        "MD043": {
          "match_case": true,
          "headings": [
            "# Measurements",
            "## Conditions",
            "## Cases",
            "## Results",
            "## Reports", "*"
          ]
        }
      }
    },
    {
      // One section per symptom, so the file grows a heading whenever a new failure
      // becomes worth naming. Only the title is pinned.
      "filter": ["docs/troubleshooting.md"],
      "combine": "merge",
      "config": {
        "MD043": { "match_case": true, "headings": ["# Troubleshooting", "*"] }
      }
    }
  ],
  "globs": ["**/*.md"],
  "ignores": [
    "tmp/**",
    "vendor/**",
    // Both are symlinks to AGENTS.md; linting the target once is enough.
    ".github/copilot-instructions.md",
    ".claude/CLAUDE.md"
  ]
}
